        {
          "name": "Policy events",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.expect(pm.response.code).to.equal(200));",
                  "const j = pm.response.json();",
                  "pm.test('returns events array', () => pm.expect(j).to.have.property('events'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/policy-events?limit=100&decision=BLOCK",
