# ==========================================================================
# PayPal Commerce Agent — Backend environment
# Copy to `.env` and fill values. NEVER commit `.env`.
# CRITICAL FIX #7: do not put real secrets in committed files.
# ==========================================================================

NODE_ENV=development
PORT=3000

# Single, explicit CORS origin (no regex / no array). Matches the Flutter/web frontend.
CORS_ORIGIN=http://localhost:3000

# --------------------------------------------------------------------------
# PayPal sandbox. Keep disabled for catalog-only local development or add
# sandbox credentials and set PAYPAL_ENABLED=true for the checkout demo.
# --------------------------------------------------------------------------
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=<paypal-sandbox-client-id>
PAYPAL_CLIENT_SECRET=<paypal-sandbox-client-secret>
# Live PayPal mode is intentionally unsupported.
PAYPAL_ENV=sandbox
# Local Android emulator URLs. For a hosted demo, use your public HTTPS backend URL:
# https://your-service.example.com/api/checkout/return
# https://your-service.example.com/api/checkout/cancel
PAYPAL_RETURN_URL=http://10.0.2.2:3000/api/checkout/return
PAYPAL_CANCEL_URL=http://10.0.2.2:3000/api/checkout/cancel
# PayPal Webhook (S5). Get this from the PayPal Developer Dashboard after
# registering a webhook endpoint, or via: npm run register-webhook <url>.
PAYPAL_WEBHOOK_ID=<paypal-webhook-id>

# --------------------------------------------------------------------------
# Merchant profile. Empty = the built-in AI Café. To run another business, point this at a JSON
# file with its name, currency, limits and products (see docs/MERCHANTS.md); path is relative to
# the backend folder. Example: examples/business-profiles/corner-bakery.json
# --------------------------------------------------------------------------
BUSINESS_PROFILE_PATH=

# --------------------------------------------------------------------------
# Durable storage (PostgreSQL). Leave DATABASE_URL empty for in-memory only
# (tests / catalog-only local runs: everything is lost on restart). On Render the
# filesystem is ephemeral, so production MUST use a managed database.
#   local:  postgres://aicafe:aicafe@localhost:5432/aicafe   (see docs/DATABASE.md)
#   Render: injected from the database in render.yaml (internal URL, no SSL needed)
# External connections to a managed database usually need DATABASE_SSL=true.
# --------------------------------------------------------------------------
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=5
# 'true' + NODE_ENV=production: refuse to start without DATABASE_URL.
REQUIRE_PERSISTENCE=false

# --------------------------------------------------------------------------
# AI providers (P10). The agent is provider-agnostic: every provider below
# speaks the OpenAI-compatible API and is tried in order as a fallback. A
# provider is ACTIVE only when its key is set. An OPENAI_API_KEY-only setup
# behaves exactly as before. The AI agent only discovers + prepares carts; it
# can NEVER call PayPal directly. Never commit real keys.
#
# VERIFIED LIVE (real API calls): Gemini and Groq (both PASS in `npm run ai:check`).
# SUPPORTED BUT UNTESTED: Cerebras, OpenRouter, OpenAI — no working key was available.
# --------------------------------------------------------------------------
# Attempt order (comma-separated). Default: gemini,groq,cerebras,openrouter,openai
AI_PROVIDER_ORDER=gemini,groq,cerebras,openrouter,openai

# Each *_MODEL accepts a COMMA-SEPARATED list (first = preferred). If a model is
# retired (HTTP 404) the next model of the same provider is tried first; a model
# that 404s is skipped for the process lifetime.
#
# Google Gemini (OpenAI-compatible endpoint).
# Default models: gemini-3.6-flash,gemini-3.5-flash (gemini-2.5-flash was retired 2026-10-16)
GEMINI_API_KEY=<gemini-api-key>
# Leave GEMINI_MODEL unset to use the defaults above. Retired ids (gemini-2.0-flash, gemini-2.5-flash,
# gemini-1.5-*) are ignored with a warning, so a stale value can no longer disable the provider.
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash

# Groq. Default models: openai/gpt-oss-120b,llama-3.3-70b-versatile
GROQ_API_KEY=<groq-api-key>
# GROQ_MODEL=openai/gpt-oss-120b,llama-3.3-70b-versatile

# Cerebras. Default model: llama-3.3-70b
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b

# OpenRouter (use a ':free' tool-capable model).
# Default model: meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI. Default model: gpt-4o-mini
OPENAI_API_KEY=<openai-api-key>
# OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------------------------------------
# Ops Copilot (merchant, READ-ONLY): PayPal Agent Toolkit with read permissions only plus the
# policy audit trail. OFF by default. It reads PayPal sandbox data and spends AI-provider quota, so it
# is only enabled when BOTH of these are set. Share the key with judges privately.
# --------------------------------------------------------------------------
OPS_COPILOT_ENABLED=false
# At least 16 characters, e.g. generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OPS_COPILOT_KEY=<merchant-ops-key-min-16-chars>
# Requests per IP per minute for the Ops Copilot (default 6). Guards AI-provider spend.
# OPS_COPILOT_PER_IP_PER_MIN=6
# true (default, judges' demo): orders / order stats / policy events are readable without a key, in a minimised
# form. false: they all require the merchant key (X-Ops-Key). Use false whenever real customer data exists.
# DASHBOARD_PUBLIC=true

# --------------------------------------------------------------------------
# Public base URL for the discovery documents (/.well-known/agent-commerce.json, agent.json, llms.txt,
# /api/feed/products). REQUIRED in production (RENDER_EXTERNAL_URL, which Render injects, is accepted when
# this is unset). Never derived from Host / X-Forwarded-* in production. Outside production an unset value falls
# back to the request origin and the responses are not publicly cacheable.
# --------------------------------------------------------------------------
# PUBLIC_BASE_URL=https://your-service.onrender.com

# --------------------------------------------------------------------------
# Cart Mandate (signed record of what the shopper was asked to approve).
# REQUIRED when NODE_ENV=production: the server refuses to start without it (src/mandate/mandate-service.ts).
# Outside production it is optional: without a key an ephemeral one is generated at boot, so mandates issued
# before a restart cannot be verified afterwards (GET /.well-known/mandate-keys.json reports keyPersistence: "ephemeral").
# A key that is SET but invalid stops the server from starting (and /api/health answers 503 "misconfigured").
# Generate one with: npm run mandate:keygen   (never commit or log the output)
# --------------------------------------------------------------------------
# MANDATE_SIGNING_KEY=
# Key rotation: after replacing MANDATE_SIGNING_KEY, list the OLD key's PUBLIC key(s) here (SPKI PEM with \n
# escapes, comma separated or a JSON array, max 5) so mandates signed earlier still verify. Private keys are refused.
# MANDATE_PREVIOUS_PUBLIC_KEYS=

# --------------------------------------------------------------------------
# Automation events (Zapier "Catch Hook", Make, n8n, a Slack bridge). Optional, off by default, NOT production-grade:
# in-memory only, up to 2 attempts, events can be lost on restart and repeated; consumers must dedupe on the event id.
# Sends order.paid / order.policy_blocked / refund.completed as JSON. With a secret the request carries
# X-AiCafe-Timestamp and X-AiCafe-Signature: sha256=<HMAC-SHA256 over "<timestamp>.<raw body>">.
# https only; private, loopback, link-local and other reserved destinations (after DNS resolution) are refused and
# redirects are never followed. Best-effort: a failing receiver never affects a payment.
# --------------------------------------------------------------------------
# AUTOMATION_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
# AUTOMATION_WEBHOOK_SECRET=<shared-secret>
# Development only (ignored in production): allow a receiver on localhost, e.g. a local n8n.
# AUTOMATION_ALLOW_LOCAL_TARGETS=false

# --------------------------------------------------------------------------
# OPTIONAL TUNING — every value below has a safe built-in default; uncomment only to change it.
# These are read by src/config/environment.ts (sessions, reservations, AI chat limits) and
# src/ops/config.ts (Ops Copilot). They are NOT required for a local run or the demo.
# --------------------------------------------------------------------------
# Reverse-proxy hops trusted for req.ip (Render = 1). 0 = trust nothing. Default: 1 in production, 0 otherwise.
# TRUST_PROXY_HOPS=1
# Server-issued anonymous sessions.
# SESSION_IDLE_TTL_MS=7200000
# SESSION_MAX_AGE_MS=86400000
# SESSION_MAX_ACTIVE=1000
# SESSION_CREATE_PER_IP_PER_HOUR=30
# Daily-spend reservations (released when an order is not paid).
# RESERVATION_TTL_MS=1800000
# RESERVATION_MAX_AGE_MS=86400000
# RESERVATION_SWEEP_INTERVAL_MS=60000
# AI chat ceilings per minute (per session / per IP / global). Lower them to protect free-tier quota.
# AI_CHAT_PER_SESSION_PER_MIN=10
# AI_CHAT_PER_IP_PER_MIN=30
# AI_CHAT_GLOBAL_PER_MIN=120
