# ==========================================================================
# AI Café — Render production environment variables (TEMPLATE, NO SECRETS)
#
# HOW TO USE:
#   Render Dashboard -> your Web Service -> Environment -> add each key below.
#   Mark PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET / PAYPAL_WEBHOOK_ID /
#   OPENAI_API_KEY as SECRET. Never paste real values into this file or git.
#
# render.yaml already sets NODE_ENV, PORT, CORS_ORIGIN, PAYPAL_ENABLED,
# PAYPAL_ENV. The ones marked (add in dashboard) are `sync: false` and must
# be entered by hand.
# ==========================================================================

NODE_ENV=production
PORT=10000

# Must match your Render service URL exactly (scheme + host, no trailing slash).
CORS_ORIGIN=https://paypal-commerce-agent-backend.onrender.com

PAYPAL_ENABLED=true
PAYPAL_ENV=sandbox

# (add in dashboard) PayPal sandbox REST app credentials.
# Developer Dashboard -> Sandbox -> Apps & Credentials -> your REST app.
PAYPAL_CLIENT_ID=<paste-sandbox-client-id>
PAYPAL_CLIENT_SECRET=<paste-sandbox-secret>

# Checkout callback URLs are derived automatically from RENDER_EXTERNAL_URL.
# Only set these explicitly if you want to override that behavior:
# PAYPAL_RETURN_URL=https://<your-service>.onrender.com/api/checkout/return
# PAYPAL_CANCEL_URL=https://<your-service>.onrender.com/api/checkout/cancel

# (add in dashboard) After deploying, register the webhook and paste the ID:
#   npm run register-webhook https://<your-service>.onrender.com/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=<paste-sandbox-webhook-id>

# (add in dashboard) OpenAI key for the AI shopping agent.
OPENAI_API_KEY=<paste-openai-api-key>

# --------------------------------------------------------------------------
# Ops Copilot (merchant, READ-ONLY): PayPal Agent Toolkit with read permissions only plus the
# policy audit trail. OFF by default. It reads PayPal sandbox data and spends OpenAI credits, so it
# is only enabled when BOTH of these are set. Share the key with judges privately.
# --------------------------------------------------------------------------
OPS_COPILOT_ENABLED=false
# At least 16 characters, e.g. generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OPS_COPILOT_KEY=
