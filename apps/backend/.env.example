# ==========================================================================
# PayPal Commerce Agent — Backend environment
# Copy to `.env` and fill values. NEVER commit `.env`.
# CRITICAL FIX #7: do not put real secrets in committed files.
# ==========================================================================

NODE_ENV=development
PORT=3000

# Single, explicit CORS origin (no regex / no array). Matches the Flutter/web frontend.
CORS_ORIGIN=http://localhost:3000

# --------------------------------------------------------------------------
# PayPal sandbox. Keep disabled for catalog-only local development or add
# sandbox credentials and set PAYPAL_ENABLED=true for the checkout demo.
# --------------------------------------------------------------------------
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Live PayPal mode is intentionally unsupported.
PAYPAL_ENV=sandbox
# Local Android emulator URLs. For a hosted demo, use your public HTTPS backend URL:
# https://your-service.example.com/api/checkout/return
# https://your-service.example.com/api/checkout/cancel
PAYPAL_RETURN_URL=http://10.0.2.2:3000/api/checkout/return
PAYPAL_CANCEL_URL=http://10.0.2.2:3000/api/checkout/cancel
# PayPal Webhook (S5). Get this from the PayPal Developer Dashboard after
# registering a webhook endpoint, or via: npm run register-webhook <url>.
PAYPAL_WEBHOOK_ID=

# --------------------------------------------------------------------------
# AI providers (P10). The agent is provider-agnostic: every provider below
# speaks the OpenAI-compatible API and is tried in order as a fallback. A
# provider is ACTIVE only when its key is set. An OPENAI_API_KEY-only setup
# behaves exactly as before. The AI agent only discovers + prepares carts; it
# can NEVER call PayPal directly. Never commit real keys.
# --------------------------------------------------------------------------
# Attempt order (comma-separated). Default: gemini,groq,cerebras,openrouter,openai
AI_PROVIDER_ORDER=gemini,groq,cerebras,openrouter,openai

# Each *_MODEL accepts a COMMA-SEPARATED list (first = preferred). If a model is
# retired (HTTP 404) the next model of the same provider is tried first; a model
# that 404s is skipped for the process lifetime.
#
# Google Gemini (OpenAI-compatible endpoint).
# Default models: gemini-3.6-flash,gemini-3.5-flash (gemini-2.5-flash was retired 2026-10-16)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash

# Groq. Default models: openai/gpt-oss-120b,llama-3.3-70b-versatile
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b,llama-3.3-70b-versatile

# Cerebras. Default model: llama-3.3-70b
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b

# OpenRouter (use a ':free' tool-capable model).
# Default model: meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI. Default model: gpt-4o-mini
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------------------------------------
# Ops Copilot (merchant, READ-ONLY): PayPal Agent Toolkit with read permissions only plus the
# policy audit trail. OFF by default. It reads PayPal sandbox data and spends OpenAI credits, so it
# is only enabled when BOTH of these are set. Share the key with judges privately.
# --------------------------------------------------------------------------
OPS_COPILOT_ENABLED=false
# At least 16 characters, e.g. generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OPS_COPILOT_KEY=
