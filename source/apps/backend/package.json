{
  "name": "paypal-commerce-agent-backend",
  "version": "1.0.0",
  "description": "AI Caf\u00e9 backend \u2014 PayPal + AI agentic commerce (Express/TypeScript, MCP server, AG Grid dashboard)",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');if(fs.existsSync('public')){fs.cpSync('public','dist/public',{recursive:true});console.log('copied public/ -> dist/public')}\"",
    "start": "node dist/src/server.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:smoke": "jest tests/smoke --runInBand",
    "register-webhook": "ts-node scripts/register-webhook.ts",
    "ai:check": "ts-node --transpile-only scripts/ai-provider-check.ts",
    "e2e:smoke": "ts-node --transpile-only scripts/e2e-smoke-test.ts",
    "e2e:sandbox": "ts-node --transpile-only scripts/e2e-sandbox-flow.ts",
    "verify:deployment": "ts-node --transpile-only scripts/verify-deployment.ts",
    "mcp:demo": "ts-node --transpile-only scripts/mcp-demo.ts",
    "db:migrate": "ts-node --transpile-only scripts/db-migrate.ts"
  },
  "dependencies": {
    "@paypal/agent-toolkit": "^1.11.0",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-json-stable-stringify": "^2.1.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "openai": "^4.56.0",
    "pg": "^8.23.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "pg-mem": "^3.0.14",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "@langchain/core": "0.3.80",
    "jsondiffpatch": "0.7.6",
    "mathjs": "15.2.0"
  }
}
